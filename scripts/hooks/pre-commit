#!/bin/sh
# Blocks committing .env files or anything that looks like an API key.
if git diff --cached --name-only | grep -E '(^|/)\.env($|\.)' >/dev/null; then
  echo "pre-commit: refusing to commit a .env file" >&2; exit 1
fi
# TMDB v3 keys are 32 hex chars; v4 tokens are long JWTs. Allow placeholders.
if git diff --cached -U0 | grep -E '^\+' | grep -vE '^\+\+\+' \
   | grep -E 'TMDB_API_KEY *= *[A-Za-z0-9._-]{20,}|api_key=[0-9a-f]{32}|eyJ[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{20,}' \
   | grep -vE 'your_key|YOUR_KEY|xxxxx' >/dev/null; then
  echo "pre-commit: staged change contains something that looks like an API key" >&2; exit 1
fi
exit 0
